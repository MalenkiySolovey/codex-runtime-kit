<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Codex.RuntimeKit</PackageId>
    <Version>0.1.0-preview.5</Version>
    <Authors>MalenkiySolovey</Authors>
    <Description>Codex configuration, isolated runtime lifecycle, app-server transport, and verified Desktop usage rendering.</Description>
    <PackageProjectUrl>https://github.com/MalenkiySolovey/codex-runtime-kit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MalenkiySolovey/codex-runtime-kit</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>codex;runtime;desktop;cdp;renderer;app-server;stdio</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Esprima" />
    <EmbeddedResource Include="Desktop\Usage\CodexDesktopNativeUsage.js"
                      LogicalName="Codex.RuntimeKit.Desktop.Usage.CodexDesktopNativeUsage.js" />
    <EmbeddedResource Include="Desktop\Usage\CodexDesktopBalanceRendererExtension.js"
                      LogicalName="Codex.RuntimeKit.Desktop.Usage.CodexDesktopBalanceRendererExtension.js" />
  </ItemGroup>
</Project>
