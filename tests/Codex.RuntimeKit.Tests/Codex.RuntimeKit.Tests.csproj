<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Codex.RuntimeKit\Codex.RuntimeKit.csproj" />
    <ProjectReference Include="..\Codex.RuntimeKit.TestServer\Codex.RuntimeKit.TestServer.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyTestServerOutput" AfterTargets="Build">
    <ItemGroup>
      <TestServerFiles Include="..\Codex.RuntimeKit.TestServer\bin\$(Configuration)\net10.0\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(TestServerFiles)" DestinationFiles="@(TestServerFiles->'$(OutDir)TestServer\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>